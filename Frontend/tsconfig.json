{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],

    "module": "ESNext",                 
    "moduleResolution": "Bundler",      

    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
